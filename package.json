{
  "name": "modern-traq",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "app:dist": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "http-proxy": "^1.18.1"
  },
  "devDependencies": {
    "@traptitech/traq": "^3.26.1-1",
    "@traptitech/traq-markdown-it": "^7.1.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.72.0",
    "oxlint": "^1.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "zustand": "^5.1.0"
  },
  "main": "electron/main.cjs",
  "productName": "traQ",
  "build": {
    "appId": "jp.trap.modern-traq",
    "productName": "traQ",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.social-networking",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signExecutable": false,
      "icon": "build/icon.png"
    }
  }
}
